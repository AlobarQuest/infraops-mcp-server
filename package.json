{
  "name": "infraops-mcp-server",
  "version": "3.4.0",
  "description": "MCP server for infrastructure operations — Coolify, Hetzner, VPS, Namecheap, Cloudflare, Supabase, and GitHub",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "infraops-audit": "dist/cli/audit-cli.js"
  },
  "scripts": {
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "audit": "node dist/cli/audit-cli.js",
    "clean": "rm -rf dist"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.1.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@porkbunllc/mcp-server": "0.54.0",
    "axios": "^1.20.0",
    "fast-xml-parser": "^5.11.2",
    "minisearch": "^7.2.0",
    "ssh2": "^1.16.0",
    "zod": "4.6.7",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/ssh2": "^1.15.6",
    "eslint": "10.13.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.72.0",
    "vitest": "5.0.5"
  }
}
